{
  "name": "@nial-infra/mobile",
  "version": "1.3.0",
  "private": true,
  "main": "index.js",
  "description": "Nial-Infra mobile app (React Native / Expo) for iOS and Android",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "bundle-check": "expo export --platform android --output-dir /tmp/nial-infra-mobile-export"
  },
  "dependencies": {
    "@nial-infra/shared": "*",
    "expo": "~52.0.0",
    "expo-build-properties": "^0.13.3",
    "expo-document-picker": "~13.0.1",
    "expo-file-system": "~18.0.4",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.6",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "^5.6.3"
  }
}
