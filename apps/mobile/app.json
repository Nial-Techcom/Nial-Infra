{
  "expo": {
    "name": "NetForge",
    "slug": "netforge",
    "version": "1.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141A22",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netforge.mobile",
      "buildNumber": "2",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.netforge.mobile",
      "versionCode": 2,
      "allowBackup": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
