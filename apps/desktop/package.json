{
  "name": "@netforge/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "NetForge desktop app (Electron shell around the web UI)",
  "main": "main.js",
  "author": {
    "name": "NetForge",
    "email": "contact@nial-tech.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "NETFORGE_DEV_URL=http://localhost:3000 electron .",
    "start": "electron .",
    "prepare-renderer": "node scripts/copy-web.js",
    "build": "npm run build -w @netforge/web && node scripts/copy-web.js",
    "dist": "npm run build && electron-builder",
    "typecheck": "node --check main.js && node --check preload.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.netforge.desktop",
    "productName": "NetForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "NetForge <contact@nial-tech.com>"
    },
    "artifactName": "NetForge-${version}-${os}-${arch}.${ext}"
  },
  "homepage": "https://github.com/Flunch4456/NetForge"
}
