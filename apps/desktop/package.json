{
  "name": "@nial-infra/desktop",
  "version": "1.5.0",
  "private": true,
  "description": "Nial-Infra desktop app (Electron shell around the web UI)",
  "main": "main.js",
  "author": {
    "name": "Nial-Infra",
    "email": "contact@nial-tech.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "NIAL_INFRA_DEV_URL=http://localhost:3000 electron .",
    "start": "electron .",
    "prepare-renderer": "node scripts/copy-web.js",
    "build": "npm run build -w @nial-infra/web && node scripts/copy-web.js",
    "dist": "npm run build && electron-builder",
    "typecheck": "node --check main.js && node --check preload.js"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nialinfra.desktop",
    "productName": "NialInfra",
    "directories": {
      "output": "release"
    },
    "artifactName": "Nial-Infra-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nial-Infra"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Nial-Infra <contact@nial-tech.com>"
    }
  },
  "homepage": "https://github.com/Nial-Techcom/Nial-Infra"
}
