{
  "name": "@infra-tech/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Infra-Tech desktop app (Electron shell around the web UI)",
  "main": "main.js",
  "author": {
    "name": "Infra-Tech",
    "email": "contact@nial-tech.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "INFRATECH_DEV_URL=http://localhost:3000 electron .",
    "start": "electron .",
    "prepare-renderer": "node scripts/copy-web.js",
    "build": "npm run build -w @infra-tech/web && node scripts/copy-web.js",
    "dist": "npm run build && electron-builder",
    "typecheck": "node --check main.js && node --check preload.js"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.infratech.desktop",
    "productName": "Infra-Tech",
    "directories": {
      "output": "release"
    },
    "artifactName": "Infra-Tech-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "msi"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Infra-Tech <contact@nial-tech.com>"
    }
  },
  "homepage": "https://github.com/Flunch4456/Infra-Tech"
}
