# Copy to .env and fill in. Generate secrets with:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me-db-password
JWT_SECRET=generate-a-random-string-of-32-characters-or-more
ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
# First administrator, created automatically when the database has no user yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Port where the web UI is published (the mobile and desktop apps use http://<this-host>:<port> as server URL)
WEB_PORT=3000
