# Copy to .env and fill in.
# POSTGRES_PASSWORD: use letters/digits only (openssl rand -hex 24), it is embedded in a URL.
# JWT_SECRET / ENCRYPTION_KEY: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-db-password
JWT_SECRET=generate-a-random-string-of-32-characters-or-more
ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
# First administrator, created automatically when the database has no user yet
ADMIN_EMAIL=admin@example.com
# At least 10 characters. In production the server REFUSES to create the admin with this sample value.
ADMIN_PASSWORD=change-me-admin-password
# Port where the web UI is published (the mobile and desktop apps use http://<this-host>:<port> as server URL)
WEB_PORT=3000
# Only needed when the web UI is served from a domain (e.g. https://nial-infra.example.com). Comma-separated.
# The desktop and mobile apps work without it.
# CORS_ORIGINS=https://nial-infra.example.com
# Address written in e-mailed links (invitations, password reset). Can also be set in the admin panel.
# PUBLIC_URL=https://nial-infra.example.com

# Optional brute-force / abuse limits (defaults shown)
# LOGIN_RATE_LIMIT=20      # login/register/reset attempts per IP per 15 min
# ACCOUNT_LOCK_LIMIT=10    # failed logins per account per 15 min before it is paused
# API_RATE_LIMIT=1000      # requests per IP per minute on the whole API

# Noms de la base PostgreSQL (facultatif ; ne les change pas sur un serveur déjà installé).
# POSTGRES_USER=nial_infra
# POSTGRES_DB=nial_infra
